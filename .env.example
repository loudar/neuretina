# ── LLM (OpenCode Go — OpenAI-compatible) ────────────────────────────────────
# Subscribe at https://opencode.ai/auth → Go → copy the API key.
OPENCODE_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4-flash
# Optional: pin one session id for routing/prompt caching. By default each
# workflow run gets its own stable id (OpenCode Go requires x-opencode-session).
# LLM_SESSION_ID=

# ── Perplexity (Search API — raw ranked results, no LLM answer) ──────────────
KEY_PERPLEXITY=

# ── ElevenLabs ───────────────────────────────────────────────────────────────
KEY_ELEVENLABS=
# Voice used for the brief. Browse voices at https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_v4
# opus_48000_128 renders as a native voice message in most Matrix clients
ELEVENLABS_OUTPUT_FORMAT=opus_48000_128
ELEVENLABS_MAX_CHARS=2600

# ── Bluesky / AT Protocol search ─────────────────────────────────────────────
# Recommended: authenticate so search goes through your PDS and is not
# rate-limited. Create an app password in Bluesky → Settings → App Passwords.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
# Optional PDS override. Leave empty (recommended): the PDS is auto-discovered
# from the account's DID document — this works for bsky.social entryway
# accounts and for sharded hosts such as *.host.bsky.network alike.
# BLUESKY_PDS_URL=https://auriporia.us-west.host.bsky.network
BLUESKY_PUBLIC_URL=https://public.api.bsky.app

# ── Matrix (voice message delivery) ──────────────────────────────────────────
# NOTE on .env quoting (Bun parses this file):
#   - "$" starts variable expansion EVEN inside quotes → write literal "$" as "\$"
#   - "#" starts a comment unless the value is quoted
#   - surrounding quotes are stripped
#   Example: password "Correct$Horse#1" must be written as "Correct\$Horse#1"
#   (In Coolify, set values in the UI instead — they are passed as-is.)
MATRIX_HOMESERVER_URL=https://matrix.illegal.trading
MATRIX_ROOM_ID=
# Option A: a static access token (see README for how to obtain one)…
MATRIX_ACCESS_TOKEN=
# …or Option B: username + password; the app logs in via m.login.password
# and caches the token (works when you don't have a token at hand).
# Username: the localpart (e.g. "auriporia") or the full ID
# (@auriporia:matrix.illegal.trading) — both work.
MATRIX_USERNAME=
MATRIX_PASSWORD=

# Chat commands: listen in the room and react to messages like
# "/start <task id or name>" (run a scheduled task now), "/list", "/status", "/help".
MATRIX_CHAT_COMMANDS=true
# Restrict who may issue commands (comma-separated Matrix IDs).
# Leave empty to allow anyone in the room.
# MATRIX_ALLOWED_SENDERS=@you:matrix.illegal.trading

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
DB_PATH=./data/app.db
TZ=Europe/Berlin
LOG_LEVEL=info
# Run integration checks on startup and send the result as a text message to
# the Matrix room (set false to disable):
STARTUP_CHECK=true
# Set by the Docker image; only needed for local production-style runs:
# WEB_DIST=./web/dist

# ── Defaults ─────────────────────────────────────────────────────────────────
# Cron for the seeded "morning-brief" job (only created on first start):
DEFAULT_BRIEF_CRON=0 7 * * *
DEFAULT_SEARCH_RECENCY=day
DEFAULT_SEARCH_RESULTS=6
DEFAULT_BRIEF_LANGUAGE=en
